# Copy to .env.local and fill in. Never commit .env.local.

# ---- Sanity CMS -------------------------------------------------------------
# Without these the site serves the local placeholder catalog in
# src/content/agents.ts and logs a warning. It will build and run either way.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ---- Contact form -----------------------------------------------------------
# Without all three, /api/contact returns an honest 503 rather than pretending
# to have delivered the message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---- Stripe -----------------------------------------------------------------
# Checkout is disabled and the UI falls back to "Book a call" when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
