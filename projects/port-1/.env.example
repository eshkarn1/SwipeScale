# Copy to .env.local (gitignored) and set on the host for deploys.
# Both are NEXT_PUBLIC_* — public by design, neither is a credential.

# Absolute origin. metadataBase, canonicals, og:image, robots.txt and
# sitemap.xml all derive from it; without it they resolve to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formspree form endpoint. The contact form posts to it natively with
# method="POST", so it works with JS disabled. No API route.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
