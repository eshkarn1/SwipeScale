# Lightline — environment template.
# Committed with every key present and BLANK (BUILD_SPEC §8).
# Copy to `.env` and fill in locally. Never commit `.env`.
# Never put a real secret or a real connection string in this file.

# ---- Database ----------------------------------------------------------
# PostgreSQL, US region only (DECISIONS §5). No database is provisioned yet.
# Prisma 7 reads this via prisma.config.ts, not from schema.prisma.
DATABASE_URL=

# ---- Site --------------------------------------------------------------
# Must be set at deploy, or the sitemap and canonicals ship pointing at
# localhost. Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ---- Auth (M1) ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client — console.cloud.google.com, OAuth 2.0 Client ID,
# authorized redirect URI {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google.
# Auth.js infers these two from the "AUTH_GOOGLE_*" name automatically.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — resend.com. Magic-link and invite email both go through this.
# When blank in a non-production environment, email is written to
# .local/dev-inbox/ instead of sent — see src/server/email.tsx.
RESEND_API_KEY=
# "Name <address>" — must be a domain verified in the Resend account once
# RESEND_API_KEY is set.
AUTH_EMAIL_FROM=
